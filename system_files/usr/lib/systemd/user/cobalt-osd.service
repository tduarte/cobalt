[Unit]
Description=On-screen display for volume and brightness keys (SwayOSD)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/swayosd-server --config /usr/share/cobalt/swayosd/config.toml --style /usr/share/cobalt/swayosd/style.css
Restart=on-failure
RestartSec=1
Slice=session.slice
