[Unit]
Description=cobalt shell (top bar, menus, launcher, notifications)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/cobalt-shell
Restart=on-failure
RestartSec=1
# The default KillMode (whole cgroup) is needed: cobalt-shell is a wrapper
# that runs gjs as a child. Apps don't live here; the shell launches them in
# their own scopes (launchApp in shell/lib/system.ts).
Slice=session.slice
