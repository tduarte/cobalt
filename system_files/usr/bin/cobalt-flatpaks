#!/usr/bin/bash
# Installs the Flathub apps in /usr/share/cobalt/flatpaks.list (run by
# cobalt-flatpaks.service at boot). It only does work when the list changes:
# the list's checksum is kept in /var/lib/cobalt/flatpaks.done.

set -euo pipefail

list=/usr/share/cobalt/flatpaks.list
stamp=/var/lib/cobalt/flatpaks.done
sum="$(sha256sum "$list" | cut -d' ' -f1)"

[[ -f "$stamp" && "$(cat "$stamp")" == "$sum" ]] && exit 0

flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
# Only apps that aren't installed at all: one from another remote (Fedora's)
# or a user install counts, and installing it again would fail the batch
missing=()
while read -r app; do
    flatpak info "$app" >/dev/null 2>&1 || missing+=("$app")
done < <(grep -Ev '^\s*(#|$)' "$list")
if ((${#missing[@]})); then
    flatpak install --system --noninteractive flathub "${missing[@]}"
fi

mkdir -p "$(dirname "$stamp")"
echo "$sum" > "$stamp"
