#!/usr/bin/bash
# GDM session entry point. The system config in /usr/share/cobalt/hypr/ comes
# with the image; personal overrides go in ~/.config/cobalt/hyprland.lua, which
# the system config loads last.

# Formats from Settings > System > Region & Language (GNOME's region key);
# gnome-session does the same for GNOME. Language (LANG) comes from GDM.
region="$(gsettings get org.gnome.system.locale region 2>/dev/null | tr -d "'")"
if [[ -n "$region" ]]; then
    for var in LC_NUMERIC LC_TIME LC_MONETARY LC_PAPER LC_MEASUREMENT LC_NAME LC_ADDRESS LC_TELEPHONE LC_IDENTIFICATION; do
        export "$var=$region"
    done
fi

# SSH keys through gcr-ssh-agent (its socket is enabled in the image), like
# GNOME: keys with a passphrase unlock from the
# login keyring. Left alone if something else already provides an agent.
if [[ -z "${SSH_AUTH_SOCK:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/gcr/ssh"
fi

exec /usr/bin/start-hyprland -- --config /usr/share/cobalt/hypr/hyprland.lua
