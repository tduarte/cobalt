#!/usr/bin/bash
# hypridle's config from GNOME's power/idle keys, so Settings > Power works
# like on GNOME:
#   org.gnome.desktop.session idle-delay              screen blank (0 = never)
#   org.gnome.desktop.screensaver lock-enabled/-delay lock after blank
#   org.gnome.settings-daemon.plugins.power idle-dim  dim before blank (backlight)
#   ... sleep-inactive-ac-type/-timeout               automatic suspend
#
#   cobalt-idle --write-config   hypridle.service runs this before it starts
#   cobalt-idle                  cobalt-idle.service: restart hypridle on changes

set -uo pipefail

config="${XDG_RUNTIME_DIR:?}/cobalt/hypridle.conf"
lock_cmd="cobalt-lock"
dpms_off="hyprctl dispatch 'hl.dsp.dpms({ action = \"disable\" })'"
dpms_on="hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })'"

get() { gsettings get "$1" "$2" | sed -E "s/^(uint32 |')//; s/'$//"; }

listener() {
    printf 'listener {\n    timeout = %s\n    on-timeout = %s\n' "$1" "$2"
    [[ -n "${3:-}" ]] && printf '    on-resume = %s\n' "$3"
    printf '}\n\n'
}

write_config() {
    local blank lock lock_delay dim suspend_type suspend_after
    blank="$(get org.gnome.desktop.session idle-delay)"
    lock="$(get org.gnome.desktop.screensaver lock-enabled)"
    lock_delay="$(get org.gnome.desktop.screensaver lock-delay)"
    dim="$(get org.gnome.settings-daemon.plugins.power idle-dim)"
    suspend_type="$(get org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type)"
    suspend_after="$(get org.gnome.settings-daemon.plugins.power sleep-inactive-ac-timeout)"

    mkdir -p "${config%/*}"
    {
        echo "# Generated by cobalt-idle from GNOME's settings; edits are overwritten."
        echo "# Fullscreen games and video inhibit idle through window rules."
        printf 'general {\n    lock_cmd = %s\n    before_sleep_cmd = loginctl lock-session\n    after_sleep_cmd = %s\n}\n\n' "$lock_cmd" "$dpms_on"
        if (( blank > 0 )); then
            # Dim half a minute before blanking (laptop panels only)
            if [[ "$dim" == "true" ]] && ls /sys/class/backlight/* >/dev/null 2>&1 && (( blank > 60 )); then
                listener $((blank - 30)) "brightnessctl -s set 30%" "brightnessctl -r"
            fi
            listener "$blank" "$dpms_off" "$dpms_on"
            [[ "$lock" == "true" ]] && listener $((blank + lock_delay)) "loginctl lock-session"
        fi
        case "$suspend_type" in
            suspend) listener "$suspend_after" "systemctl suspend" ;;
            hibernate) listener "$suspend_after" "systemctl hibernate" ;;
        esac
    } > "$config"
}

if [[ "${1:-}" == "--write-config" ]]; then
    write_config
    exit 0
fi

{
    gsettings monitor org.gnome.desktop.session idle-delay &
    gsettings monitor org.gnome.desktop.screensaver &
    gsettings monitor org.gnome.settings-daemon.plugins.power &
    wait
} | while read -r line; do
    case "$line" in
        idle-delay* | lock-enabled* | lock-delay* | idle-dim* | sleep-inactive-ac-*)
            systemctl --user restart hypridle.service ;;
    esac
done
