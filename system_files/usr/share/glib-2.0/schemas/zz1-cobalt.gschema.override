# Defaults the Settings app will later manage. libadwaita apps read these
# through xdg-desktop-portal-gtk's settings portal.
[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='blue'
gtk-theme='adw-gtk3-dark'
icon-theme='Adwair'
cursor-theme='Bibata-Modern-Ice'
cursor-size=24
font-name='Adwaita Sans 11'
document-font-name='Adwaita Sans 11'
monospace-font-name='Adwaita Mono 11'

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:close'

# Default wallpaper (shell-drawn; the overview reuses it)
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/cobalt/boliviainteligente-37WxvlfW3to.jpg'
picture-uri-dark='file:///usr/share/backgrounds/cobalt/boliviainteligente-37WxvlfW3to.jpg'
picture-options='zoom'

# Default dash favorites for new users (GNOME's own key, so an existing GNOME
# setup carries over)
[org.gnome.shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'app.zen_browser.zen.desktop', 'steam.desktop', 'com.mitchellh.ghostty.desktop', 'dev.zed.Zed.desktop']

# Night Light: manual schedule (sunset/sunrise needs location services); the
# shell applies it through hyprsunset
[org.gnome.settings-daemon.plugins.color]
night-light-schedule-automatic=false
night-light-schedule-from=20.0
night-light-schedule-to=6.0

# A gaming desktop shouldn't suspend mid-download; turn it on in Settings >
# Power (cobalt-idle turns these keys into hypridle's config)
[org.gnome.settings-daemon.plugins.power]
sleep-inactive-ac-type='nothing'

# GNOME sets this only for its own desktop ([org.gnome.mutter:GNOME]);
# Hyprland workspaces are dynamic too, so match it
[org.gnome.mutter]
dynamic-workspaces=true

# rpm-ostreed and flatpak's timer already download updates; GNOME Software is
# the store and the manual updates page, and the shell says when an OS update
# is ready
[org.gnome.software]
download-updates=false
download-updates-notify=false
