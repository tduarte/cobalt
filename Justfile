# Run a virtual machine using systemd-vmspawn
[group('Run Virtal Machine')]
spawn-vm rebuild="0" type="qcow2" ram="6G":
    #!/usr/bin/env bash

    set -euo pipefail

    [ "{{ rebuild }}" -eq 1 ] && echo "Rebuilding the ISO" && just build-vm {{ rebuild }} {{ type }}

    systemd-vmspawn \
      -M "bootc-image" \
      --console=gui \
      --cpus=2 \
      --ram=$(echo {{ ram }}| numfmt --from=iec) \
      --network-user-mode \
      --vsock=false --pass-ssh-key=false \
      -i ./output/**/*.{{ type }}

# Runs shell check on all Bash scripts
lint:
    #!/usr/bin/env bash
    set -eoux pipefail
    # Check if shellcheck is installed
    if ! command -v shellcheck &> /dev/null; then
        echo "shellcheck could not be found. Please install it."
        exit 1
    fi
    # Run shellcheck on all Bash scripts
    find . -iname "*.sh" -type f -exec shellcheck "{}" ';'

# Runs shfmt on all Bash scripts
format:
    #!/usr/bin/env bash
    set -eoux pipefail
    # Check if shfmt is installed
    if ! command -v shfmt &> /dev/null; then
        echo "shfmt could not be found. Please install it."
        exit 1
    fi
    # Run shfmt on all Bash scripts
    find . -iname "*.sh" -type f -exec shfmt --write "{}" ';'

# Dev VM in GNOME Boxes (see docs/BRIEF.md "Development setup")
dev_vm := env("COBALT_VM", "silverblue43")
dev_vm_gpu := env("COBALT_VM_GPU", "/dev/dri/by-path/pci-0000:03:00.0-render")

# Boxes' play button drops the GPU pin and libvirt falls back to the iGPU,
# which is too slow at 4K, so re-apply the pin on every start.
# Start the dev VM with virgl on dev_vm_gpu (then view it in Boxes)
[group('Dev VM')]
vm-start:
    #!/usr/bin/env bash
    set -euo pipefail
    virsh() { flatpak run --command=virsh org.gnome.Boxes -c qemu:///session "$@"; }
    # Boxes' sandbox has its own /tmp, so the XML must live somewhere shared
    xml="$(mktemp -p "$HOME/.cache" cobalt-vm.XXXXXX.xml)"
    trap 'rm -f "$xml"' EXIT
    virsh dumpxml --inactive "{{ dev_vm }}" \
        | sed -E "s|<gl enable='[a-z]+'[^>]*/>|<gl enable='yes' rendernode='{{ dev_vm_gpu }}'/>|; s|accel3d='no'|accel3d='yes'|" \
        > "$xml"
    virsh define "$xml" >/dev/null
    virsh start "{{ dev_vm }}"

# Gracefully shut down the dev VM
[group('Dev VM')]
vm-stop:
    flatpak run --command=virsh org.gnome.Boxes -c qemu:///session shutdown "{{ dev_vm }}"

# SSH into the dev VM (forwarded on 127.0.0.1:2222). Arguments are passed as-is
# to ssh, so a quoted command runs entirely in the VM, pipes included.
[group('Dev VM')]
[positional-arguments]
vm-ssh *args:
    @ssh -i "$HOME/.ssh/cobalt-vm" -p 2222 -o UserKnownHostsFile="$HOME/.ssh/known_hosts.cobalt-vm" "$USER@127.0.0.1" "$@"

# Local registry the dev VM pulls from (reachable in the VM as 10.0.2.2:5000)
[group('Dev VM')]
registry:
    #!/usr/bin/env bash
    set -euo pipefail
    if podman container exists cobalt-registry; then
        podman start cobalt-registry >/dev/null
    else
        podman run -d --name cobalt-registry -p 127.0.0.1:5000:5000 \
            -v cobalt-registry:/var/lib/registry docker.io/library/registry:2 >/dev/null
    fi
    echo "cobalt-registry running on 127.0.0.1:5000"

# Build the image and push it to the local registry as cobalt:dev
[group('Dev VM')]
vm-push: registry
    just build {{ image_name }} dev
    podman push --tls-verify=false localhost/{{ image_name }}:dev 127.0.0.1:5000/{{ image_name }}:dev

# A guest reboot with GL on crashes QEMU's SPICE (gl_draw_cookie assertion),
# so power off and cold-start instead.
# Point the VM at the local cobalt:dev image (first time) or pull the latest, then restart it
[group('Dev VM')]
vm-update:
    #!/usr/bin/env bash
    set -euo pipefail
    target="10.0.2.2:5000/{{ image_name }}:dev"
    just vm-ssh "sudo mkdir -p /etc/containers/registries.conf.d && printf '[[registry]]\nlocation = \"10.0.2.2:5000\"\ninsecure = true\n' | sudo tee /etc/containers/registries.conf.d/50-cobalt-dev.conf >/dev/null"
    if just vm-ssh "sudo bootc status --format=json" | grep -q "$target"; then
        just vm-ssh "sudo bootc upgrade"
    else
        just vm-ssh "sudo bootc switch $target"
    fi
    just vm-ssh "sudo systemctl poweroff" || true
    for _ in $(seq 1 60); do
        [ "$(flatpak run --command=virsh org.gnome.Boxes -c qemu:///session domstate "{{ dev_vm }}" | head -1)" = "shut off" ] && break
        sleep 2
    done
    just vm-start

# Replaces the running shell; logs go to /tmp/cobalt-shell.log in the VM.
# Run the shell from this checkout in the VM's Hyprland session (no image rebuild)
[group('Dev VM')]
shell-dev:
    #!/usr/bin/env bash
    set -euo pipefail
    tar -C shell --exclude=node_modules --exclude=@girs -cf - . \
        | just vm-ssh 'rm -rf ~/.cache/cobalt-shell-dev && mkdir -p ~/.cache/cobalt-shell-dev && tar -C ~/.cache/cobalt-shell-dev -xf -'
    just vm-ssh 'export XDG_RUNTIME_DIR=/run/user/$(id -u) HYPRLAND_INSTANCE_SIGNATURE=$(ls -t /run/user/$(id -u)/hypr | head -1); systemctl --user stop cobalt-shell.service 2>/dev/null || true; ags quit -i cobalt >/dev/null 2>&1 || true; pkill -x cobalt-shell || true; sleep 0.5; hyprctl dispatch "hl.dsp.exec_cmd(\"ags run -d $HOME/.cache/cobalt-shell-dev > /tmp/cobalt-shell.log 2>&1\")" >/dev/null'

# Save a screenshot of the VM's Hyprland session to the given local path
[group('Dev VM')]
vm-screenshot path="vm-screenshot.png":
    just vm-ssh 'XDG_RUNTIME_DIR=/run/user/$(id -u) WAYLAND_DISPLAY=wayland-1 grim -' > "{{ path }}"
